{
  "name": "swagger-typescript-api-es",
  "version": "0.1.6",
  "keywords": [],
  "homepage": "https://github.com/hunghg255/swagger-typescript-api-es",
  "bugs": {
    "url": "https://github.com/hunghg255/swagger-typescript-api-es/issues"
  },
  "license": "MIT",
  "author": "hunghg255",
  "repository": {
    "type": "git",
    "url": "https://github.com/hunghg255/swagger-typescript-api-es"
  },
  "bin": {
    "swagger-typescript-api-es": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild && cp -r ./templates ./dist",
    "dev": "unbuild --stub",
    "test:cli": "node dist/cli.mjs",
    "test:cli1": "tsx src/cli.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "start": "tsx play/test.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:immutability": "STA_FREEZE=1 vitest run",
    "bench": "npm run build && node bench/index.mjs",
    "bench:compare": "npm run build && npm --prefix bench/compare ci --no-audit --no-fund && node bench/compare/run.mjs",
    "changelog": "npx changeloggithub@latest --all true && git add CHANGELOG.md && git commit -m 'chore: update CHANGELOG.md'",
    "prepublishOnly": "npm run build",
    "release": "bumpp -r && npm publish"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "es-toolkit": "^1.52.0",
    "eta": "^2.2.0",
    "js-yaml": "^4.2.0",
    "oxfmt": "^0.56.0",
    "picocolors": "^1.1.1",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.9.3",
    "undici": "^6.28.1",
    "unreadconfig": "^0.0.13"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.0",
    "@types/swagger2openapi": "^7.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "axios": "^1.20.0",
    "bumpp": "^10.4.1",
    "oxlint": "^1.71.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
